# Server runtime
PORT=3001
NODE_ENV=development

# Exact client origin (no trailing slash) — used for CORS and CSP connect-src
CLIENT_URL=http://localhost:5173

# Supabase — SERVER ONLY, never commit real values
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Anthropic — SERVER ONLY. Powers POST /api/transactions/parse (natural-language
# QuickAdd) and POST /api/ask (Ask Trim chat). If unset, /parse returns 503 and
# the client falls back to the structured form; /ask returns 503.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ask Trim — optional. Switches the system prompt to the cold-open variant
# (no one-shot example) for the tone audit in scripts/askEval.js. Defaults to
# one-shot when unset.
# ASK_PROMPT_VARIANT=cold-open

# Phase 9.5 at-rest encryption — SERVER ONLY.
#
# UNSET is a valid, safe state: with no key the routes read and write plaintext
# exactly as they do today, which is what lets the route sweep ship and be
# proven in production before any encryption is switched on.
#
# ALEX GENERATES THIS, NOBODY ELSE (AGENTS.md). Never let an assistant produce,
# print or handle it:
#     openssl rand -base64 32
#
# Back it up in TWO offline places BEFORE putting it here or in Vercel. After
# migration 013 drops the plaintext columns this key is the ONLY way to read any
# user's financial history — losing it is permanent, total data loss for every
# user. See SECURITY.md, "Encryption at rest".
# DATA_ENCRYPTION_KEY=

# Which stage of the encryption rollout the routes are in. See SECURITY.md.
#   off  (default) — plaintext only. Identical to pre-9.5 behaviour.
#   dual           — write both columns, read ciphertext when present.
#                    Set this AFTER migration 012 is applied.
#   enc            — ciphertext only. Set this ONLY after migration 013.
# ENCRYPTION_PHASE=off
