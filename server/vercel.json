{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [{ "path": "/api/cron/recurrences", "schedule": "0 3 * * *" }]
}
